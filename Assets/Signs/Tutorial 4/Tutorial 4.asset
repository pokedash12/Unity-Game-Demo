  m_Script: {fileID: 11500000, guid: f7fa08f93af2eb24b84b0350686a7cfa, type: 3}
  m_Name: Tutorial 4
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  signName: 
  dialogLines:
  - Navigate  the  battle  menu  using  z  to  select,  x  to  cancel,  and  arrow 
    keys  to  navigate.
  - Attack  does  a  basic  physical  attack
  - Skill  let's  you  spend  mp  to  use  a  skill
  - Item  let's  you  use  an  item  (only  on  the  player)
  - Flee  let's  you  try  to  run
  - Talk  let's  you  try  to  convince  an  enemy  to  teach you a skill
  - Use  it  on  a  weakened  enemy  (the  game  will  say  when  you  weaken  one)
  - Note  that  it  may  fail  for  a  variety  of  reasons
  typingSpeed: 0.05
  voiceSound: {fileID: 8300000, guid: d7fa8f3b55cc89d45a706139ecccc23f, type: 3}
